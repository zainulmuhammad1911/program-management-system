# Salin file ini menjadi .env dan sesuaikan bila perlu.
# Nilai default berikut sudah cocok dengan docker-compose.yml (service db).
DATABASE_URL="postgresql://pms:pms@localhost:5432/pms_dev?schema=public"

# Auth.js (Google OAuth)
# AUTH_SECRET: generate dengan `openssl rand -base64 32`, beda nilai per environment.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: dari Google Cloud Console > OAuth Client (Web application).
# Authorized redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
